NODE_ENV=production
GAME_ROOM_AUTH_MODE=cognito
GAME_ROOM_ORIGIN=https://game.sumomoli.com
GAME_ROOM_HOST=127.0.0.1
GAME_ROOM_PORT=4177
# Keep closed until canvas identity capacity and the compatible backup pass.
GAME_ROOM_DRAWING_ENABLED=0
# Keep 250 until Agora's dedicated identity/check route and actual capacity are verified.
# 125 is an explicit opt-in for the legacy Cognito provider; queue/deadline stay 4s/8s.
GAME_ROOM_IDENTITY_CHECK_INTERVAL_MS=250
# Central signed-batch route, registered caller key, clock and capacity must be verified first.
# Keep disabled until the separately coordinated production installation is complete.
GAME_ROOM_IDENTITY_BATCH_ENABLED=0
# GAME_ROOM_IDENTITY_BATCH_KEY_ID=game-room-production-v1
# GAME_ROOM_IDENTITY_BATCH_KEY_FILE=/run/credentials/game-room.service/identity-batch-key
# Set the independent client delivered by Agora; an empty value refuses startup.
GAME_ROOM_CLIENT_ID=
GAME_ROOM_STORE_PATH=/var/lib/game-room/game.sqlite
GAME_ROOM_BACKUP_DIR=/var/lib/game-room/backups
# Own private Lightsail bucket, attached to this instance. No account access keys in this file.
GAME_ROOM_BACKUP_BUCKET=
# Enable only when the production authorization explicitly covers this retention policy.
# Retain latest 48 generated snapshots and one daily point for 30 UTC days.
GAME_ROOM_BACKUP_PRUNE=0
GAME_ROOM_SESSION_ABSOLUTE_SECONDS=3600
GAME_ROOM_SESSION_IDLE_SECONDS=1800
GAME_ROOM_READ_CACHE_SECONDS=60
