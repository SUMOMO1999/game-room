NODE_ENV=production
GAME_ROOM_AUTH_MODE=cognito
GAME_ROOM_ORIGIN=https://game.sumomoli.com
GAME_ROOM_HOST=127.0.0.1
GAME_ROOM_PORT=4177
# Set the independent client delivered by Agora; an empty value refuses startup.
GAME_ROOM_CLIENT_ID=
GAME_ROOM_STORE_PATH=/var/lib/game-room/game.sqlite
GAME_ROOM_BACKUP_DIR=/var/lib/game-room/backups
# Own private Lightsail bucket, attached to this instance. No account access keys in this file.
GAME_ROOM_BACKUP_BUCKET=
# Enable only when the production authorization explicitly covers this retention policy.
# Retain latest 48 generated snapshots and one daily point for 30 UTC days.
GAME_ROOM_BACKUP_PRUNE=0
GAME_ROOM_SESSION_ABSOLUTE_SECONDS=3600
GAME_ROOM_SESSION_IDLE_SECONDS=1800
GAME_ROOM_READ_CACHE_SECONDS=60
