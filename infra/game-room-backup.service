[Unit]
Description=Consistent encrypted game-room business backup
After=game-room.service

[Service]
Type=oneshot
User=game-room
Group=game-room
WorkingDirectory=/opt/game-room/current
EnvironmentFile=/etc/game-room/runtime.env
LoadCredential=store-key:/etc/game-room/store-key
Environment=GAME_ROOM_STORE_KEY_FILE=%d/store-key
ExecStart=/opt/node/bin/node scripts/scheduled-backup.mjs
UMask=0077
StateDirectory=game-room
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/game-room
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=300
