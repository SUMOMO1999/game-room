# Copy to a protected deployment environment; this template does not enable production.
# Production must receive its own verified client ID from Agora.
NODE_ENV=production
GAME_ROOM_AUTH_MODE=cognito
GAME_ROOM_ORIGIN=https://game.sumomoli.com
GAME_ROOM_HOST=127.0.0.1
GAME_ROOM_PORT=4177
# GAME_ROOM_CLIENT_ID=
# GAME_ROOM_STORE_PATH=/var/lib/game-room/game.sqlite
# GAME_ROOM_STORE_KEY_FILE=/run/credentials/game-room.service/store-key
# GAME_ROOM_STORE_KEY=  (alternative only: 32 random bytes, base64url, injected server-side)
GAME_ROOM_SESSION_ABSOLUTE_SECONDS=3600
GAME_ROOM_SESSION_IDLE_SECONDS=1800
GAME_ROOM_READ_CACHE_SECONDS=60
