  "fieldConventions": {
    "id": "稳定ASCII slug；显示名或中文译名变化不改变id。",
    "name": "按官方卡面记原名；统一长连字符和夏威夷语拼写的排版字符。",
    "points": "卡面左下黑色分值徽记中的印刷分值。",
    "cost": "只计闪电前的印刷费用；0明确表示该资源图标未印在费用栏。野生动物作为费用时必须支付野生动物，不能用普通资源反向替代。",
    "hasInstantAction": "卡面是否印有闪电图标；与instantEffect分别记录用于复核。",
    "instantEffect": "游览公园后立即发生；none表示卡面明确无闪电奖励，null只用于无法辨识的待复核字段。",
    "needsReview": "true表示本条有不可辨识或冲突的事实字段；false只表示本次转录无未解读数，不等于已经通过独立复核或实现验收。"
  },
  "effectDefinitions": {
    "none": "无卡面即时奖励。",
    "gain_resources": "立即获得resources指定数量的资源，后续容量与空池遵从通用规则。",
    "gain_canteen": "立即获得1枚水壶，后续摆放遵从水壶规则；该图标不是获得1水或立即填水壶。",
    "take_shutterbug_badge": "取得摄影徽章；不是直接获得照片。",
    "roll_trail_die": "掷步道骰1次并按骰面处理；实际结果属于对局状态，不写入卡库。"
  },
