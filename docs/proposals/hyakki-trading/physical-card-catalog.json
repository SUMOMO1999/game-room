  "resolvedReviewTopics": {
    "responses": {
      "sourceGap": "番商在交易前后哪个节点取得牌，买办嵌套货物牌能否响应；锦衣卫取消后行动、额外费用和双方牌的去向；响应必须先于秘密公开。",
      "resolutionDocument": "digital-rulings.md",
      "section": 3,
      "status": "maintainer-decided-not-official"
    },
    "prices": {
      "sourceGap": "多张书算是否叠加、价格下限、与买办的价格修改顺序；收费临时格另列费用，不能误算成每件货物折扣。",
      "resolutionDocument": "digital-rulings.md",
      "section": 4,
      "status": "maintainer-decided-not-official"
    },
    "auction": {
      "sourceGap": "牙郎先报价者、最低加价、开头放弃、付款目的地、钱不足的选择及容量；花魁已明确使用者先报价且三张整体成交。",
      "resolutionDocument": "digital-rulings.md",
      "section": 6,
      "status": "maintainer-decided-not-official"
    },
    "capacity": {
      "sourceGap": "临时格占用与腾空、交换重分的格位处理、人物容量不足时挑留的范围；道具得货是否允许同样取舍。",
      "resolutionDocument": "digital-rulings.md",
      "section": 4,
      "status": "maintainer-decided-not-official"
    },
    "supply": {
      "sourceGap": "公库某种货物不足时的合法性和交换是否必须足额；六种货物实体各有多少需清点。",
      "resolutionDocument": "digital-rulings.md",
      "section": 4,
      "status": "maintainer-decided-not-official"
    },
    "deck": {
      "sourceGap": "抽牌不足跨洗牌、双空、搜索全堆无目标、卦师放回顺序及重复搜索边界；不能用无限重洗卡住回合。",
      "resolutionDocument": "digital-rulings.md",
      "section": 5,
      "status": "maintainer-decided-not-official"
    },
    "no-target": {
      "sourceGap": "目标空缺或无变化动作是否允许发动、支付前检查和不可逆效果的取消点，集中定通则而非各界面猜测。",
      "resolutionDocument": "digital-rulings.md",
      "section": 5,
      "status": "maintainer-decided-not-official"
    },
    "visibility": {
      "sourceGap": "卦师和两仪灯临时牌的可见范围，堪舆师盲抽方式；县丞、花魁和公开搜索依牌效开放信息，不泄漏其余私牌。",
      "resolutionDocument": "digital-rulings.md",
      "section": 9,
      "status": "maintainer-decided-not-official"
    },
    "tools": {
      "sourceGap": "同名实体分别横置；光棍竖直重分后的再次使用，术士借用已横置/自弃型道具的费用与指代；牺牲对象限哪一方的区。",
      "resolutionDocument": "digital-rulings.md",
      "section": 6,
      "status": "maintainer-decided-not-official"
    },
    "timing": {
      "sourceGap": "纸上仙位于普通取牌前，多个同名实例与可跳过阶段一的顺序；到行动上限后应先完成在途效果再结束。",
      "resolutionDocument": "digital-rulings.md",
      "section": 2,
      "status": "maintainer-decided-not-official"
    }
  },
